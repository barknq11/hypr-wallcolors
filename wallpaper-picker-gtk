#!/usr/bin/env python3
"""Wallpaper grid picker (GTK4).

Shows every wallpaper in a wide grid, sorted newest-first, and applies the
chosen one with `hypr-set-wallpaper` (sets the wallpaper + full theme).

Usage: wallpaper-picker-gtk [folder]
"""

import hashlib
import os
import subprocess
import sys

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Gdk", "4.0")
from gi.repository import Gdk, Gtk, Pango  # noqa: E402

WALLS = sys.argv[1] if len(sys.argv) > 1 else os.path.expanduser("~/Pictures/wallpapers")
CACHE = os.path.join(
    os.environ.get("XDG_CACHE_HOME", os.path.expanduser("~/.cache")), "wallpicker"
)
THUMB = 360, 220
EXTS = (".png", ".jpg", ".jpeg", ".webp", ".bmp", ".gif")


def wallpaper_files():
    imgs = []
    for root, _, names in os.walk(WALLS):
        for name in names:
            path = os.path.join(root, name)
            if name.lower().endswith(EXTS):
                imgs.append(path)
    # newest first
    imgs.sort(key=lambda p: os.path.getmtime(p), reverse=True)
    return imgs


def thumb(path):
    mtime = int(os.path.getmtime(path))
    ident = hashlib.md5((path + str(mtime)).encode()).hexdigest()[:12]
    out = os.path.join(CACHE, ident + ".png")
    if not os.path.exists(out):
        subprocess.run(
            ["magick", path, "-thumbnail", f"{THUMB[0]}x{THUMB[1]}^",
             "-gravity", "center", "-extent", f"{THUMB[0]}x{THUMB[1]}", out],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        )
    return out if os.path.exists(out) else None


def apply_wallpaper(path):
    subprocess.Popen(["hypr-set-wallpaper", path],
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def make_item(path):
    name = os.path.basename(path)
    pic = Gtk.Picture()
    pic.set_content_fit(Gtk.ContentFit.COVER)
    pic.set_size_request(THUMB[0], THUMB[1])

    t = thumb(path)
    if t:
        try:
            pic.set_filename(t)
        except Exception:
            pass

    gesture = Gtk.GestureClick()
    gesture.set_button(1)
    gesture.connect("pressed", lambda *a: (apply_wallpaper(path), win.close()))
    pic.add_controller(gesture)

    name_label = Gtk.Label(label=name)
    name_label.set_ellipsize(Pango.EllipsizeMode.END)
    name_label.set_xalign(0)

    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
    box.append(pic)
    box.append(name_label)
    box.set_tooltip_text("%s — %d KiB" % (name, os.path.getsize(path) // 1024))
    return box


files = wallpaper_files()
if not files:
    print("no wallpapers found in %s" % WALLS, file=sys.stderr)
    sys.exit(1)
os.makedirs(CACHE, exist_ok=True)

win = Gtk.Window()
win.set_title("Wallpapers — %d | newest first" % len(files))
win.set_default_size(1280, 760)

header = Gtk.HeaderBar()
header.set_title_widget(Gtk.Label(label="Wallpapers — click one to set it"))
win.set_titlebar(header)

flow = Gtk.FlowBox()
flow.set_selection_mode(Gtk.SelectionMode.NONE)
flow.set_min_children_per_line(1)
flow.set_row_spacing(10)
flow.set_column_spacing(10)
for path in files:
    flow.append(make_item(path))

sw = Gtk.ScrolledWindow()
sw.set_child(flow)
sw.set_vexpand(True)

box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
box.append(sw)
win.set_child(box)

key = Gtk.EventControllerKey()
key.connect("key-pressed", lambda c, kv, code, st: (win.close(), True)
            if kv == Gdk.KEY_Escape else False)
win.add_controller(key)

win.present()
Gtk.main()